{
  "name": "trel-launcher",
  "version": "0.5.0",
  "description": "Trel — лаунчер Minecraft для Windows и Linux: каталог Java/Bedrock-версий, модлоадеры, моды, миры, серверы, скины и импорт из других лаунчеров.",
  "main": "dist-electron/main/main.js",
  "author": {
    "name": "Griln",
    "email": "griln@example.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "icon": "node scripts/build-icon.js",
    "skins": "node scripts/skins/build-soul.js",
    "build:trel-emu": "node scripts/build-trel-emu.js",
    "build:trel-emu-pack": "node scripts/build-trel-emu-pack.js",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "electron .",
    "test": "vitest run",
    "dist": "npm run icon && npm run build && electron-builder --win",
    "dist:linux": "npm run icon && npm run build && electron-builder --linux && npm run dist:rpm",
    "dist:rpm": "bash scripts/build-rpm-manual.sh",
    "dist:publish": "npm run icon && npm run build && node scripts/publish-with-token.js",
    "smartscreen": "node scripts/smartscreen-hashes.js"
  },
  "dependencies": {
    "@xmcl/core": "2.15.1",
    "adm-zip": "^0.5.17",
    "axios": "^1.7.7",
    "electron-updater": "^6.8.3",
    "prismarine-nbt": "^2.8.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.5",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.61.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.171.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.trel.launcher",
    "productName": "Trel",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "dist-electron/preload/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/legacy",
        "to": "legacy",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/platform-tools",
        "to": "platform-tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Griln",
        "repo": "Trel",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Trel-${version}-${arch}.${ext}",
      "publisherName": "Trel"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "differentialPackage": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Trel",
      "createDesktopShortcut": "always",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "Trel.exe"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Trel-${version}-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "Trel-${version}-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "Trel-${version}-${arch}.deb",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libdrm2",
        "libgbm1",
        "libasound2",
        "libappindicator-gtk3"
      ]
    },
    "rpm": {
      "artifactName": "Trel-${version}-${arch}.rpm",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-atk",
        "libdrm",
        "mesa-libgbm",
        "alsa-lib",
        "libappindicator-gtk3"
      ]
    }
  },
  "homepage": "https://github.com/Griln/Trel"
}